# Copy to workspace/.env.auth, fill secrets locally, never commit that file.
# Use reachable HTTPS origins without trailing slashes. localhost HTTP is
# supported only for local development (PKCE needs Web Crypto).
WORKSPACE_WEB_ORIGIN=https://workspace.example.com
WORKSPACE_API_URL=https://api.example.com
KEYCLOAK_PUBLIC_URL=https://auth.example.com
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
# Enable only after configure_auth.py has validated and configured SMTP.
OIDC_REGISTRATION_ENABLED=0
